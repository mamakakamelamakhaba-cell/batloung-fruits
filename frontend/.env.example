# =====================================================================
#  FRONTEND — Vercel environment variable
#  Vercel → Project → Settings → Environment Variables → Production + Preview
#  (Vite bakes this in at build time, so you MUST redeploy after changing it.)
# =====================================================================

# Full URL of the Render backend INCLUDING /api.
# Example: https://batloung-fruits-api.onrender.com/api
# The client also appends /api for you if you forget it.
VITE_API_URL=https://your-backend-name.onrender.com/api
