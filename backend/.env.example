# =====================================================================
#  BACKEND — Render environment variables
#  Paste these into Render → your service → Environment (never commit .env)
# =====================================================================

# --- Option A (RECOMMENDED for Aiven / Railway / Clever Cloud) ---------
# One connection string from your database provider's dashboard.
# Elegantly handles special characters in the password.
# Example:
# DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb
DATABASE_URL=

# --- Option B (classic variables — local machine / old hosts) ---------
# Leave DATABASE_URL empty above to use these.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# On a hosted server this MUST be the database name your host gave you
# (Aiven calls it "defaultdb" unless you renamed it).
DB_NAME=batloung_fruits
DB_SSL=false

# --- App ---------------------------------------------------------------
# Aiven requires TLS. db.js turns SSL on automatically when DATABASE_URL
# is used; set to "false" only for a local, non-TLS MySQL.
PORT=5000

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# --- CORS --------------------------------------------------------------
# The exact Vercel URL(s), comma separated, no trailing slash.
# Preview deploys (*.vercel.app) are allowed automatically.
CLIENT_ORIGIN=https://batloung-fruits-frontend.vercel.app

# --- Database setup passphrase -----------------------------------------
# Required for POST /api/admin/setup?key=THIS_VALUE
# Use a long random string. You only need it once.
SETUP_KEY=change_this_to_a_long_random_setup_key
